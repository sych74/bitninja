type: update
id: bitninja
version: 6.1.0
name: BitNinja Service
logo: images/logo.png
homepage: https://bitninja.io/

baseUrl: https://raw.githubusercontent.com/jelastic-jps/bitninja/main

onBeforeInit: |
  var resp = jelastic.dev.scripting.Eval("a498b13745283f7f3dbab7a31ed7d348", session, "wizard.ui", {
    groupType: "${account.groupType:}",
    uid: "${user.uid}"
  });
  return resp.response ? resp.response:resp;

nodeGroupAlias:
  ${targetNodes.nodeGroup}: group

description:
  short: BitNinja All-in-One Server Protection

menu:
  - caption: BitNinja Admin Panel
    href: https://admin.bitninja.io/site/login

buttons:
  - confirmText: Restart BitNinja agent?
    loadingText: Restarting BitNinja agent...
    action: restartBitNinja
    caption: Restart Agent
    successText: BitNinja agent has been restarted.
  - caption: Agent Update
    action: updateAgent
    successText: BitNinja agent has been successfully updated

targetNodes:
  nodeType:
    - tomcat6
    - tomcat7
    - tomcat8
    - tomcat85
    - tomcat9
    - tomcat
    - tomee
    - tomee-dockerized
    - glassfish3
    - glassfish4
    - glassfish
    - jetty
    - jetty6
    - apache
    - apache2
    - nginxphp
    - apache2-ruby
    - nginx-ruby
    - nginx
    - nginx-dockerized
    - nginxphp-dockerized
    - haproxy
    - apache-lb
    - varnish
    - varnish-dockerized
    - payara
    - wildfly
    - nodejs
    - apache-ruby
    - apache-python
    - nginxruby
    - litespeedphp
    - litespeedadc
    - lemp
    - llsmp
    - jenkins
    - jenkins2
    - kubernetes
    - storage
    - mariadb
    - mariadb10
    - mariadb-dockerized
    - mysql
    - mysql5
    - postgresql
    - postgres9
    - postgres10
    - postgres11
    - postgres12
    - postgres13
    - postgres14
    - memcached
    - memcached-dockerized
    - mongo
    - mongodb
    - mongodb-dockerized
    - couchbase
    - opensearch
    - opensearch1
    - redis
    - redis6
    - perconadb
    - springboot
    - javaengine
    - golang
    - dotnet

globals:
  action: /etc/bitninja/jelastic_action
  HoneypotConfig: /etc/bitninja/PortHoneypot/config.ini
  EXTEND_PERM: /etc/jelastic/extendperm.conf
  KEYS: /var/lib/jelastic/keys/
  backupConfig: bitninja.sysctl.conf.backup
  bitninja_label: BitNinja Service
  minCloudlets: 4
  mqSocket: /var/lib/bitninja/mq.sock
  mqProcess: /opt/bitninja-mq/bin/bitninja-mq-server
  mainLog: /var/log/bitninja/main.log
  cliLog: /var/log/bitninja/mod.cli.log
  cliHelper: /usr/local/bin/bn-cli

onAfterStart: 
  - updateLicenses: renew
  - reloadPlatformConfig

onBeforeStop: 
  - deleteLicenses: terminate

onBeforeClone:
  cmd [group]: test /etc/bitninja  && echo 'clone' > ${globals.action} || exit 0
  user: root

onAfterClone:
  - script: return {result:0, jps:MANIFEST};
  - install: ${response.jps}
    envName: ${event.response.env.envName}
    nodeGroup: ${targetNodes.nodeGroup}
    settings: ${settings}
  - cleanAction
    
onAfterRedeployContainer[${targetNodes.nodeGroup}]:
  - if ('${event.params.nodeGroup}' == '${targetNodes.nodeGroup}'):
    - cmd [${targetNodes.nodeGroup}]: |-
        yum -y remove bitninja-repo; rm -f /etc/yum.repos.d/BitNinja.repo
        if grep -q 'AlmaLinux' /etc/system-release; then 
            yum install -y initscripts libxcrypt-compat && \
            rpm -Uvh http://rpm.bitninja.io/1.0/noarch/bitninja-repo-1.0-1.noarch.rpm && \
            sed -i 's|baseurl=.*|baseurl=http://rpm.bitninja.io/8/$basearch|g' /etc/yum.repos.d/BitNinja.repo;
        else 
            rpm -Uvh http://rpm.bitninja.io/1.0/noarch/bitninja-repo-1.0-1.noarch.rpm;
        fi
        yum -y install bitninja
      user: root
    - enableInitScript
    - disableBitNinjaAutoLoad
    - applyPlatformConfig
  - disableIPForwarding

onBeforeServiceScaleOut[${targetNodes.nodeGroup}]:
  cmd[${event.response.nodes.join(id,)}]: test /etc/bitninja && echo 'scale' > ${globals.action} || exit 0
  user: root

onAfterServiceScaleOut[${targetNodes.nodeGroup}]:
  - if (${targetNodes.nodeGroup.length:0}): deleteLicenses
  - if (!${targetNodes.nodeGroup.length:0}): reinstallBitNinja
  - disableIPForwarding
  - applyPlatformConfig
  - cleanAction

onAfterScaleIn[${targetNodes.nodeGroup}]:
  - if (${targetNodes.nodeGroup.length:0}): deleteLicenses
  - if (!${targetNodes.nodeGroup.length:0}):
      manageLicenses: scale
    
onAfterSetExtIpCount:
  - if (${event.response.result:1} == 0):
      env.control.GetNodeInfo[${event.params.nodeid}]
  - if (${event.response.result:1} == 0 && '${response.node.nodeGroup}' == '${targetNodes.nodeGroup}'):
      refreshNodeConfig:
        nodeid: ${response.node.id}

onAfterAttachExtIp:
  - if (${event.response.result:1} == 0):
      env.control.GetNodeInfo[${event.params.nodeid}]
  - if (${event.response.result:1} == 0 && '${response.node.nodeGroup}' == '${targetNodes.nodeGroup}'):
      refreshNodeConfig:
        nodeid: ${response.node.id}

onBeforeDetachExtIp:
  - env.control.GetNodeInfo[${event.params.nodeid}]
  - if ('${response.node.nodeGroup}' == '${targetNodes.nodeGroup}'):
      refreshNodeConfig:
        nodeid: ${response.node.id}

onBeforeDelete: uninstallBitninja

onUninstall: uninstallBitninja

onInstall: 
  - setMinCloudlets
  - setupBitninja

actions:
  setMinCloudlets:
    - cmd[${targetNodes.master.id}]:
        if grep -a 'AlmaLinux' /etc/system-release &>/dev/null; then
            echo "7";
        else
            echo "4";
        fi
      user: root
    - setGlobals:
        minCloudlets: ${response.out}

  setupBitninja:
    - if (${targetNodes.first.flexibleCloudlets} < ${globals.minCloudlets}):
        script: |
          return { result: "warning", message: "Target node cloudlets count are not satisfied [BitNinja system requirements](https://doc.bitninja.io/docs/Installation/system_requirements). At least ${globals.minCloudlets} cloudlets are required." }
    - manageLicenses
    - forEach(license:response.licenses):
        installAgent:
          licenseKey: ${@license.licenseKey}
          id: ${@license.id}
    - enableInitScript
    - disableBitNinjaAutoLoad
    - addRedeployConfDir
    - backupIPForwarding
    - disableIPForwarding
    - if (${quota.firewall.enabled}):
        allowFirewallPorts
    - applyPlatformConfig
  
  reinstallBitNinja: 
    - cmd[${targetNodes.master.id}]: service bitninja restart
      user: root
    - manageLicenses
    - forEach(license:response.licenses):
        - uninstallAgent: ${@license.id}
        - removeLogs: ${@license.id}
        - installAgent:
            licenseKey: ${@license.licenseKey}
            id: ${@license.id}
        - enableInitScript
        - disableBitNinjaAutoLoad

  uninstallBitninja:
    - manageLicenses: uninstall
    - forEach(license:response.licenses):
        uninstallAgent: ${@license.id}
    - removeLogLinks
    - removeFavoriteDir
    - removeRedeployConfDir
    - restoreIPForwarding
    - if (${quota.firewall.enabled}):
        denyFirewallPorts

  updateLicenses:
    - manageLicenses: ${this:}
    - forEach(license:response.licenses):
        cmd [${@license.id}]: bitninja-config --provision-key='${@license.licenseKey}' && service bitninja restart
        user: root

  deleteLicenses:
    manageLicenses: ${this:uninstall}

  manageLicenses:
    - script: |
        var params = {
          nodeGroup: "${targetNodes.nodeGroup}",
          envName: "${env.name}",
          action: "${this:}"
        };
        var resp = jelastic.dev.scripting.Eval("a498b13745283f7f3dbab7a31ed7d348", session, "license", params);
        return resp.response ? resp.response:resp;

  uninstallAgent:
    cmd [${this}]: |-
      service bitninja stop; yum -y remove --noautoremove 'bitninja*'; 
      rm -Rf /opt/bitninja*; rm -Rf /var/lib/bitninja*; rm -Rf /etc/bitninja*;
      sed -i "s|;/etc/bitninja||g" ${globals.EXTEND_PERM}
      jem filemanager extendperm
    user: root
  
  restartBitNinja:
    - cmd [group]: service bitninja restart
      user: root
    - reloadPlatformConfig

  removeLogs:
    cmd [${this}]: rm -Rf /var/log/bitninja*;
    user: root

  removeLogLinks:
    cmd [group]: |-
      for link in $(find /var/log -maxdepth 2 -type l -name 'bitninja*' 2>/dev/null); do
        case "$(readlink $link)" in
          /var/log/bitninja*) rm -f $link;;
        esac
      done
      exit 0
    user: root

  installAgent:
    cmd [${this.id}]: |-
      yum -y remove bitninja-repo; rm -f /etc/yum.repos.d/BitNinja.repo
      curl https://get.bitninja.io/install.sh | /bin/bash -s - --license_key='${this.licenseKey}' -y --serverConfigurationMetadata='{"label": "${targetNodes.nodeType}", "provider": "jelastic" }' --environmentSpecification='{"nodeGroup": "${targetNodes.nodeGroup}", "environmentName": "${env.name}", "environmentDomain": "${env.domain}" }'
    user: root

  updateAgent:
    - cmd [group]: yum -y install bitninja
      user: root
    - reloadPlatformConfig

  enableInitScript:
    cmd [group]: |-
      curl  -fsSL "${baseUrl}/scripts/init.sh" -o /etc/rc.d/init.d/jelastic-bitninja && \
      chmod +x /etc/rc.d/init.d/jelastic-bitninja && \
      chkconfig --add jelastic-bitninja
    user: root

  disableBitNinjaAutoLoad:
    cmd [group]: |-
      if systemctl is-enabled bitninja >/dev/null 2>&1; then
        systemctl disable bitninja
      elif chkconfig --list bitninja >/dev/null 2>&1; then
        chkconfig --del bitninja
      else
        echo "BitNinja service autoload is already disabled or the service is absent"
      fi
    user: root

  installCliHelper:
    cmd [${this.nodeid:group}]: |-
      cat > ${globals.cliHelper} <<'HELPER'
      #!/bin/bash
      # Wrapper around bitninjacli: the CLI exits 0 even when the message queue is
      # unavailable, so failures are detected from the lines it appends to the log.
      before=$(wc -l < ${globals.cliLog} 2>/dev/null || echo 0)
      out=$(bitninjacli "$@" 2>&1); rc=$?
      [ -n "$out" ] && echo "$out" | sed -e 's/\x1b\[[0-9;]*m//g'
      [ $rc -eq 0 ] || exit $rc
      tail -n +$((before + 1)) ${globals.cliLog} 2>/dev/null | grep -qiE 'redis.*not available|could not send command' && exit 1
      exit 0
      HELPER
      chmod +x ${globals.cliHelper}
    user: root

  applyPlatformConfig:
    - installCliHelper
    - waitBitNinjaReady
    - waitCloudConfigSync
    - addFavoriteDir: ${targetNodes.nodeGroup}
    - denyPortHoneypot
    - enableWAF3
    - persistCloudConfig
    - reloadModules
    - fixBitNinjaPerms: ${targetNodes.nodeGroup}
    - makeLogsVisible

  reloadPlatformConfig:
    - installCliHelper
    - waitBitNinjaReady
    - enableWAF3
    - reloadModules

  refreshNodeConfig:
    - installCliHelper:
        nodeid: ${this.nodeid}
    - waitBitNinjaReady:
        nodeid: ${this.nodeid}
    - enableWAF3:
        nodeid: ${this.nodeid}

  persistCloudConfig:
    cmd [${this.nodeid:group}]: |-
      bn_cli() { ${globals.cliHelper} "$@"; }
      n=0
      until bn_cli --syncconfigs; do
        n=$((n+1))
        if [ "$n" -ge 5 ]; then echo "WARN: bitninjacli --syncconfigs failed after $n attempts, local config is not pushed to BitNinja Central" >&2; break; fi
        sleep 5
      done
    user: root

  reloadModules:
    cmd [${this.nodeid:group}]: |-
      bn_cli() { ${globals.cliHelper} "$@"; }
      for module in System PortHoneypot WAF3; do
        bn_cli --module=$module --reload || echo "WARN: failed to reload BitNinja module $module" >&2
      done
    user: root

  addFavoriteDir:
    - cmd [${this}]: |-
        for cfg in /etc/bitninja/*/config.ini; do
          grep -qE '^[;[:space:]]*retain_rights' "$cfg" || continue
          sed -i -E 's/^[;[:space:]]*retain_rights[[:space:]]*=[[:space:]]*0/retain_rights=1/' "$cfg"
        done
        grep -l 'retain_rights=1' /etc/bitninja/*/config.ini
      user: root
    - env.file.AddFavorite[group]:
        path: /etc/bitninja
        keyword: BitNinja
        isDir: true

  fixBitNinjaPerms:
    cmd [${this}]: |-
      str=$(awk '/./{line=$0} END{print line}' ${globals.EXTEND_PERM})
      grep -q "/etc/bitninja" ${globals.EXTEND_PERM} || sed -i "s|${str}|${str};/etc/bitninja|g" ${globals.EXTEND_PERM}
      find /etc/bitninja -type d -exec chmod 755 {} +
      find /etc/bitninja -type f -exec chmod 644 {} +
      jem filemanager extendperm
    user: root

  removeFavoriteDir:
    env.file.RemoveFavorite:
      nodeGroup: ${targetNodes.nodeGroup}
      path: /etc/bitninja

  waitBitNinjaReady:
    cmd [${this.nodeid:group}]: |-
      bn_cli() { ${globals.cliHelper} "$@"; }
      waited=0
      while [ $waited -lt 180 ]; do
        if [[ -S ${globals.mqSocket} ]] && pgrep -f ${globals.mqProcess} >/dev/null; then
          if bn_cli --module=System --reload >/dev/null 2>&1; then
            echo "BitNinja command dispatch is ready after ${waited}s"
            exit 0
          fi
        fi
        [ $waited -lt 30 ] && step=2 || step=5
        sleep $step
        waited=$((waited + step))
      done
      echo "WARN: BitNinja cannot dispatch CLI commands after ${waited}s, the configuration steps below may be lost" >&2
      exit 0
    user: root

  waitCloudConfigSync:
    cmd [${this.nodeid:group}]: |-
      if [[ ! -f ${globals.mainLog} ]]; then
        echo "WARN: ${globals.mainLog} is absent, skipping cloud configuration wait" >&2
        exit 0
      fi
      waited=0
      while [ $waited -lt 180 ]; do
        if tac ${globals.mainLog} | awk '/Starting module initialization/{exit} index($0,"Cloud configuration downloaded."){found=1; exit} END{exit !found}'; then
          echo "Initial cloud configuration pull has finished after ${waited}s"
          exit 0
        fi
        [ $waited -lt 30 ] && step=2 || step=5
        sleep $step
        waited=$((waited + step))
      done
      echo "WARN: cloud configuration pull was not observed in ${globals.mainLog} after ${waited}s, local config changes may be overwritten by a later pull" >&2
      exit 0
    user: root

  enableWAF3:
    cmd [${this.nodeid:group}]: |-
      bn_cli() { ${globals.cliHelper} "$@"; }
      waf3_enabled() {
        bitninjacli --module=WAF3 --status 2>&1 | grep -qE '"enabled"[[:space:]]*:[[:space:]]*true'
      }
      n=0
      until waf3_enabled; do
        n=$((n + 1))
        if [ $n -gt 5 ]; then
          echo "WARN: WAF3 is still reported as disabled after $((n - 1)) enable attempts" >&2
          break
        fi
        bn_cli --module=WAF3 --enabled || echo "WARN: WAF3 enable attempt $n was not dispatched" >&2
        sleep 5
      done
      if waf3_enabled; then
        bn_cli --module=WAF3 --regenerate || echo "WARN: WAF3 config regeneration was not dispatched" >&2
      fi
      if bitninjacli --licenseinfo 2>&1 | grep -q 'no_payment'; then
        echo "WARN: BitNinja license is no_payment, WAF Pro traffic interception will not start on this server" >&2
      fi
      echo "WAF3 module status:"
      bitninjacli --module=WAF3 --status 2>&1 | sed -e 's/\x1b\[[0-9;]*m//g'
      if waf3_enabled; then
        if ss -tln 2>/dev/null | grep -qE ':(60414|60415)([[:space:]]|$)' &&
           nft list chain ip bitninja N-BN_WAF_REDIR 2>/dev/null | grep -qE 'dnat|redirect'; then
          echo "WAF Pro is inspecting traffic on 60414/60415"
        else
          echo "WARN: WAF3 reports enabled, but no proxy listens on 60414/60415 and N-BN_WAF_REDIR is empty, so no request is inspected (BitNinja WAF Pro does not generate its proxy config, JE-76574 finding 1)" >&2
        fi
      fi
      exit 0
    user: root

  makeLogsVisible:
    - script: |
        var resp, items, item, path;

        resp = api.env.control.GetLogsList('${env.name}', session, '${targetNodes.master.id}');
        if (resp.result != 0) return resp;
        items = resp.array;

        for (var i = 0, n = items.length; i < n; i++)
          if (items[i].type == "GROUP")
            if (items[i].items && items[i].items[0]) {
              item = items[i].items[0];

              return {
                result: 0,
                path: item.path.replace(item.name, "")
              }
            }
    - cmd [${targetNodes.nodeGroup}]: |-
        pathLog="${response.path:}";
        if [[ -z ${pathLog} || ! -d ${pathLog} ]]; then
          for dir in /var/log/httpd /var/log/nginx /var/log/apache2 /var/log/litespeed; do
            [[ -d $dir ]] && pathLog="$dir" && break
          done
        fi
        [[ -z ${pathLog} ]] && pathLog="/var/log"
        echo "Exposing BitNinja logs in ${pathLog}"

        link_log() {
          local src="$1" name="$2"
          [[ -d "${src}" && ! -e "${pathLog}/${name}" ]] && ln -s "${src}" "${pathLog}/${name}"
        }
        link_log "/var/log/bitninja" "bitninja"
        link_log "/var/log/bitninja-waf3" "bitninja-waf3"
        find /var/log/bitninja /var/log/bitninja-waf3 \( -type d -exec chmod 755 {} + \) -o \( -type f -exec chmod 644 {} + \) 2>/dev/null
        exit 0;
      user: root

  addRedeployConfDir:
    cmd [group]: CONF="/etc/jelastic/redeploy.conf"; grep -q 'bitninja' $CONF || echo "/etc/bitninja" >> $CONF
    user: root
    
  removeRedeployConfDir:
    if (${env.status} == 1):
      cmd [group]: sed -i '/bitninja/d' /etc/jelastic/redeploy.conf
      user: root
  
  disableIPForwarding:
    cmd [group]: |-
      sysctl -w net.ipv4.ip_forward=0
      sysctl -w net.ipv6.conf.all.forwarding=0
    user: root
      
  restoreIPForwarding:
    cmd [group]: |-
      sysctl -w net.ipv4.ip_forward=$(grep "net.ipv4.ip_forward" ${globals.KEYS}/${globals.backupConfig} | awk '{print $3}')
      ipv6=$(grep "net.ipv6.conf.all.forwarding" ${globals.KEYS}/${globals.backupConfig} | awk '{print $3}')
      [[ -n "${ipv6}" ]] && sysctl -w net.ipv6.conf.all.forwarding=${ipv6}
    user: root

  backupIPForwarding:
    cmd [group]: |-
      mkdir -p ${globals.KEYS}
      {
        echo "net.ipv4.ip_forward = $(cat /proc/sys/net/ipv4/ip_forward)"
        echo "net.ipv6.conf.all.forwarding = $(cat /proc/sys/net/ipv6/conf/all/forwarding)"
      } > ${globals.KEYS}/${globals.backupConfig}
    user: root
    
  allowFirewallPorts:
    - denyFirewallPorts
    - script: |
        var ports = [60412, 60413, 60201, 60210, "60211-60250", 60414, 60415], rules = [], resp;

        for (var i = 0, n = ports.length; i < n; i++) {
          rules.push({
            direction: "INPUT",
            nodeGroup: "${targetNodes.nodeGroup}",
            name: "${globals.bitninja_label}",
            protocol: "TCP",
            ports: ports[i],
            src: "ALL",
            priority: 1000,
            action: "ALLOW",
            isEnabled: true
          });
        }

        return api.environment.security.AddRules("${env.name}", session, toJSON(rules), "${targetNodes.nodeGroup}");

  denyFirewallPorts:
    script: |
      var resp, rules, rm_rules = [];
      
      resp = api.environment.security.GetRules("${env.name}", session, "${targetNodes.nodeGroup}");
      if (resp.result != 0) return resp;
      
      rules = resp.rules;
      
      for (var i = 0, n = rules.length; i < n; i++) {
        if (rules[i].name == "${globals.bitninja_label}") {
          rm_rules.push(rules[i].id);
        }
      }
      
      if (rm_rules.length) {
        resp = api.environment.security.RemoveRules("${env.name}", session, rm_rules);
        if (resp.result != 0) return resp;
      }
      
      return {
        result: 0
      }
      
  denyPortHoneypot:
    cmd[group]: |-
      [[ -f "${globals.HoneypotConfig}" ]] && {
        for port in 12345 12346; do
          sed -i "/^\[ports_always_use\]/,/^\[/{/^ports\[\]=${port}$/d}" ${globals.HoneypotConfig}
          if ! awk -v p="${port}" '/^\[ports_never_use\]/{found=1} found && $0 ~ "ports\\[\\]=" p {exit 0} /^\[/ && !/^\[ports_never_use\]/{found=0} END{exit 1}' ${globals.HoneypotConfig}; then
            sed -i "/^\[ports_never_use\]/a ports[]=${port}" ${globals.HoneypotConfig}
          fi
        done
      } || exit 0;
    user: root
  
  cleanAction:
    cmd [group]: test /etc/bitninja  && echo '' > ${globals.action} || exit 0
    user: root
